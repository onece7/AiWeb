
{
  "C_Cpp.errorSquiggles": "enabled",

  "go.useLanguageServer": true,

  "gopls": {
    "analyses": {
      "unusedparams": true,   // 未使用参数 → 报错
      "unusedvariable": true, // 未使用变量 → 报错
      "undeclaredname": true, // 未定义变量 → 报错
      "nilness": true        // 空指针风险 → 报错
    },
    "diagnostics": {
      "enable": true // 开启所有错误诊断
    }
  },
  // 确保.go文件被正确识别（避免识别为纯文本）
  "files.associations": {
    "*.go": "go"
  }
}